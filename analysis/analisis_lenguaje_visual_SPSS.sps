* MUESTRA DE REFERENCIA - ANALISIS DE LENGUAJE VISUAL.
* Cambiar las rutas antes de ejecutar.

SET UNICODE=ON.
SET DECIMAL=DOT.

GET DATA
 /TYPE=TXT
 /FILE='C:\CAMBIAR_RUTA\analisis_lenguaje_visual\field_scheme_binary_primary.csv'
 /ENCODING='UTF8'
 /DELCASE=LINE /DELIMITERS="," /QUALIFIER='"'
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=
 ID_CAMPO A16 ID_PIEZA A16 TIPO_FUENTE A28 FORMA_ANALITICA A30
 SITIO_ANALITICO A80 SECTOR_ANALITICO A50 CLASE_SIMETRIA A12
 ATMOSFERA_COCCION A20 PINTURA A20 GRUPO_COCCION_PINTURA A35
 N_ESQUEMAS_ANALITICOS F3.0 N_ESQUEMAS_PRIMARIOS F3.0
 CATALOGO_PENDIENTE_CAMPO F1.0 E1 TO E37 F1.0.
DATASET NAME Campos.

SELECT IF (CATALOGO_PENDIENTE_CAMPO=0).
EXECUTE.

FREQUENCIES VARIABLES=E1 TO E37.
MULT RESPONSE
 GROUPS=$ESQUEMAS 'Esquemas' (E1 TO E37 (1))
 /FREQUENCIES=$ESQUEMAS.

GET DATA
 /TYPE=TXT
 /FILE='C:\CAMBIAR_RUTA\analisis_lenguaje_visual\schemes_long.csv'
 /ENCODING='UTF8'
 /DELCASE=LINE /DELIMITERS="," /QUALIFIER='"'
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=
 ID_CAMPO A16 ID_PIEZA A16 ID_DIBUJO A16 TIPO_FUENTE A28
 FORMA_ANALITICA A30 SITIO_ANALITICO A80 SECTOR_ANALITICO A50
 CLASE_SIMETRIA A12 ATMOSFERA_COCCION A20 PINTURA A20
 GRUPO_COCCION_PINTURA A35 ESQUEMA_FUENTE A8 ESQUEMA_ANALITICO A8
 CATALOGO_PENDIENTE F1.0 INCLUIR_PRIMARIO F1.0.
DATASET NAME EsquemasLong.
SELECT IF (INCLUIR_PRIMARIO=1).
EXECUTE.

CROSSTABS /TABLES=FORMA_ANALITICA BY ESQUEMA_ANALITICO /CELLS=COUNT ROW COLUMN.
CROSSTABS /TABLES=SECTOR_ANALITICO BY ESQUEMA_ANALITICO /CELLS=COUNT ROW COLUMN.
CROSSTABS /TABLES=CLASE_SIMETRIA BY ESQUEMA_ANALITICO /CELLS=COUNT ROW COLUMN.

AUTORECODE VARIABLES=FORMA_ANALITICA ESQUEMA_ANALITICO
 /INTO FORMA_N ESQUEMA_N /PRINT.

* Requiere el modulo Categories:
* CORRESPONDENCE TABLE=FORMA_N BY ESQUEMA_N
*  /DIMENSIONS=2 /MEASURE=CHISQ /STANDARDIZE=RCMEAN
*  /PRINT=TABLE RPOINTS CPOINTS /PLOT=NDIM(1,2) BIPLOT.

GET DATA
 /TYPE=TXT
 /FILE='C:\CAMBIAR_RUTA\analisis_lenguaje_visual\piece_profiles.csv'
 /ENCODING='UTF8'
 /DELCASE=LINE /DELIMITERS="," /QUALIFIER='"'
 /ARRANGEMENT=DELIMITED /FIRSTCASE=2
 /VARIABLES=
 ID_PIEZA A16 N_CAMPOS F3.0 FORMA A30 SITIO A80
 ATMOSFERA_COCCION A20 PINTURA A20 GRUPO_COCCION_PINTURA A35
 E1 TO E37 F1.0 N_ESQUEMAS_DISTINTOS F3.0.
DATASET NAME Piezas.

FREQUENCIES VARIABLES=FORMA SITIO N_CAMPOS N_ESQUEMAS_DISTINTOS.
MULT RESPONSE
 GROUPS=$ESQPIEZA 'Esquemas por pieza' (E1 TO E37 (1))
 /FREQUENCIES=$ESQPIEZA.

* Jaccard/PERMANOVA y pruebas de robustez: usar el script R.
